#!/bin/sh
# Narrow optional extension launcher for the exact backed-up CGS1 SnowApp.
# This file's name deliberately contains SnowApp: the vendor process-count
# watchdog continues seeing the supervisor during the brief fallback transition
# instead of accumulating fast crash/reboot attempts. The child is still the
# original SnowApp, with original arguments and native sensor acquisition.
set -u
base=/data/.esphome-cgs1
app=/data/bin/SnowApp
helper="$base/pm_qt_bridge.so"
disabled="$base/pm-helper.disabled"
attempted=/tmp/qingping-pm-helper.attempted

if [ -f "$disabled" ] || [ -f "$attempted" ] || [ ! -r "$helper" ]; then
    exec "$app" "$@"
fi

# Exactly one extended launch per boot. If it exits for any reason, permanently
# disable the extension and immediately replace this supervisor with stock.
# There is no repeated loader/crash experiment inside the vendor watchdog loop.
umask 077
: > "$attempted"
CGS1_PM_BRIDGE=1 LD_PRELOAD="$helper" "$app" "$@" &
child=$!
wait "$child"
result=$?
: > "$disabled"
echo "CGS1 optional PM helper exited ($result); returning to stock" >&2
exec "$app" "$@"
